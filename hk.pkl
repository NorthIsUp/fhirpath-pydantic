amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
steps {
  ["ruff"] {
    check = "uv run ruff check src tests typings tools"
    fix = "uv run ruff check --fix src tests typings tools"
  }
  ["format"] {
    check = "uv run ruff format --check src tests typings tools"
    fix = "uv run ruff format src tests typings tools"
  }
  ["ty"] { check = "uv run ty check" }
  ["pyright"] { check = "uv run pyright" }
  ["lock"] { check = "uv lock --check" }
}
