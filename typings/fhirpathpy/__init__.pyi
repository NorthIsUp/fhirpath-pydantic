from collections.abc import Mapping
from typing import Protocol
from fhirpath_pydantic.types import Collection, Value
class Evaluator(Protocol):
    def __call__(self, resource: Mapping[str, Value], context: Mapping[str, Value] | None = None) -> Collection: ...
def compile(path: str) -> Evaluator: ...
def evaluate(resource: Mapping[str, Value], path: str, context: Mapping[str, Value] | None = None) -> Collection: ...
