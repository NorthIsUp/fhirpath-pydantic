from collections.abc import Iterator
from typing import ClassVar

from antlr4.error.ErrorListener import ErrorListener
from antlr4.tree.Tree import TerminalNode

class Token:
    EOF: ClassVar[int]

class InputStream:
    def __init__(self, data: str) -> None: ...

class CommonTokenStream:
    def __init__(self, lexer: Lexer) -> None: ...
    def LA(self, offset: int) -> int: ...

class Lexer:
    def __init__(self, input: InputStream) -> None: ...
    def removeErrorListeners(self) -> None: ...
    def addErrorListener(self, listener: ErrorListener) -> None: ...

class Parser:
    def __init__(self, input: CommonTokenStream) -> None: ...
    def removeErrorListeners(self) -> None: ...
    def addErrorListener(self, listener: ErrorListener) -> None: ...

class ParserRuleContext:
    def getChildren(self) -> Iterator[ParserRuleContext | TerminalNode]: ...
    def getText(self) -> str: ...
